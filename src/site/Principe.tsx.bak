import { Link } from 'react-router-dom';
import NodNav from '@/components/NodNav';
import NodFooter from '@/components/NodFooter';
import { Eyebrow, Icon, QuotePanel, url, vars } from '@/components/nod';
import { useLanguage } from '@/contexts/LanguageContext';
import lightFold from '@/assets/brand/light-fold-warm.webp';
import orangePressee from '@/assets/brand/orange-pressee.webp';
import silhouette from '@/assets/brand/golden-hour-silhouette.webp';
import nnenaImg from '@/assets/nnena.webp';

/* Le principe. Manifeste repris mot pour mot du site NOD, posé dans la forme
   du design system : en-tête illustré, manifeste sur photographie, méthode en
   bande dégradée, portrait en split. */

export default function Principe() {
  const { language } = useLanguage();
  const t = (fr: string, en: string) => (language === 'fr' ? fr : en);

  const methode = [
    {
      fr: 'Un interlocuteur', en: 'One contact',
      frV: "Une seule personne prend ton idée et la mène jusqu'au bout.",
      enV: 'One person takes your idea and carries it through.',
    },
    {
      fr: 'Un cercle choisi', en: 'A chosen circle',
      frV: 'Les bons créatifs derrière, quand le projet en a besoin.',
      enV: 'The right creatives behind, when the project needs them.',
    },
    {
      fr: 'Une direction', en: 'One direction',
      frV: "Ton projet avance sans que tu aies à coordonner cinq prestataires.",
      enV: 'Your project moves without you coordinating five suppliers.',
    },
  ];

  return (
    <>
      <NodNav overImage />

      <section className="page-head" style={vars({ '--nod-head-image': url(lightFold) })}>
        <div className="page-head__image" />
        <div className="page-head__veil" />
        <div className="page-head__foot" />
        <div className="page-head__body">
          <Eyebrow tone="light">{t('Le principe', 'The principle')}</Eyebrow>
          <h1 className="page-head__title">
            {t("Ce n'est pas une agence.", 'Not an agency.')}
            <br />
            {t("C'est une maison.", "It's a house.")}
          </h1>
          <p className="page-head__lede">
            {t('Un interlocuteur. Un cercle choisi derrière lui.', 'One contact. A chosen circle behind them.')}
          </p>
        </div>
      </section>

      {/* ---------- Le manifeste ---------- */}
      <section className="home-manifesto" style={vars({ '--nod-manifesto-image': url(orangePressee) })}>
        <div className="home-manifesto__image" />
        <div className="home-manifesto__veil" />
        <div className="home-manifesto__body nod-grain">
          <p className="home-manifesto__lead">
            {t(
              "Un projet ne meurt presque jamais par manque d'idée. Il meurt avant même d'exister, pour deux raisons.",
              'A project almost never dies from a lack of ideas. It dies before it even exists, for two reasons.',
            )}
          </p>

          <div className="principe-raisons">
            <div className="principe-raison">
              <h2 className="principe-raison__h">{t('Le doute.', 'Doubt.')}</h2>
              <p className="principe-raison__p">
                {t(
                  "Trop d'incertitudes, trop de questions sans réponse. L'idée reste dans ta tête au lieu de prendre forme.",
                  'Too much uncertainty, too many unanswered questions. The idea stays in your head instead of taking shape.',
                )}
              </p>
            </div>
            <div className="principe-raison">
              <h2 className="principe-raison__h">{t("Le manque d'accompagnement.", 'The lack of support.')}</h2>
              <p className="principe-raison__p">
                {t(
                  "Tu sais ce que tu veux créer. Tu ne sais pas par où commencer, ni qui pour te tenir du début à la fin.",
                  'You know what you want to create. You do not know where to start, nor who will hold it from beginning to end.',
                )}
              </p>
            </div>
          </div>

          <p className="principe-pull">{t('NOD répond aux deux.', 'NOD answers both.')}</p>

          <p className="home-manifesto__text">
            {t(
              "Une seule personne prend ton idée là où elle n'est encore qu'une pensée, la mène jusqu'au jour où elle existe pour de vrai. Stratégie, identité, contenu, développement : même main du début à la fin. Rien ne se perd en route, parce que personne ne se passe le relais.",
              'One person takes your idea while it is still only a thought, and carries it to the day it exists for real. Strategy, identity, content, development: the same hand from start to finish.',
            )}
          </p>
        </div>
      </section>

      {/* ---------- La méthode ---------- */}
      <section className="house-method nod-grain">
        <div className="house-method__inner">
          <Eyebrow tone="light">{t('La méthode', 'The method')}</Eyebrow>
          <div className="house-method__rows">
            {methode.map((ligne, index) => (
              <div className="house-method__row" key={ligne.fr}>
                <span className="house-method__index">{String(index + 1).padStart(2, '0')}</span>
                <span className="house-method__key">{t(ligne.fr, ligne.en)}</span>
                <span className="house-method__value">{t(ligne.frV, ligne.enV)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ---------- Qui ---------- */}
      <section id="qui" className="house-founder" style={vars({ '--nod-house-image': url(nnenaImg) })}>
        <div className="house-founder__body">
          <Eyebrow>{t('Qui', 'Who')}</Eyebrow>
          <h2 className="house-founder__title">{t('Nnéna a fondé NOD en 2025.', 'Nnéna founded NOD in 2025.')}</h2>
          <p className="house-founder__text">
            {t(
              "Elle vient de l'événementiel et de la communication, code en autodidacte depuis 2022. NOD est né à la croisée des trois : le sens de l'orchestration, le goût de l'image, la main qui construit.",
              'She comes from events and communication, and has been coding self-taught since 2022. NOD was born at the crossroads of the three.',
            )}
          </p>
          <p className="house-founder__text">
            {t('Soin du détail, cohérence, exigence esthétique.', 'Care for detail, coherence, aesthetic exigence.')}
          </p>
          <p>
            <Link to="/contact" className="nod-btn nod-btn--secondary">
              {t('Entrer en contact', 'Get in touch')} <Icon name="arrow-right" size={18} />
            </Link>
          </p>
        </div>
        <div className="house-founder__image" />
      </section>

      {/* ---------- L'heure dorée ---------- */}
      <QuotePanel image={silhouette} align="start" className="principe-quote">
        {t(
          "On appelle golden hour ce moment où la lumière rend tout plus juste, plus beau, plus vivant. C'est l'instant que NOD cherche pour ton projet. Celui où il existe enfin.",
          'Golden hour is the moment when light makes everything truer, more beautiful, more alive. That is the moment NOD looks for in your project.',
        )}
      </QuotePanel>

      <NodFooter />
    </>
  );
}
